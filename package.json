{
  "name": "objav-detvu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interaktívny geografický výskumný projekt o Detve a Podpoľaní.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "verify": "node scripts/verify-pages.mjs && node scripts/verify-survey.mjs",
    "check": "npm run typecheck && node scripts/check-images.mjs && node scripts/check-locations.mjs && node scripts/check-survey.mjs && npm run smoke && npm run build && npm run verify",
    "images": "node scripts/fetch-images.mjs"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "leaflet": "^1.9.4",
    "react": "^19.1.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.3"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.4",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "typescript": "~5.9.2",
    "vite": "^7.1.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
